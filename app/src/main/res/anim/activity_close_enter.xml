<?xml version="1.0" encoding="utf-8"?>
<!-- Part of the tvOS-style return transition (MainActivity's own launch-mask
     doc, ui/values/themes.xml's windowAnimationStyle) — how the launcher
     itself scales/fades back into view once the app covering it finishes.
     Mirrors activity_close_exit's scale direction in reverse. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <scale
        android:duration="250"
        android:fromXScale="0.92"
        android:fromYScale="0.92"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
    <alpha
        android:duration="200"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>
